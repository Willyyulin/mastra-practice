# Databricks AI Gateway（模型）。token 是自己在 workspace 產生的 PAT，見 README
DATABRICKS_HOST=https://你的-workspace.cloud.databricks.com
DATABRICKS_AI_GATEWAY_TOKEN=
DATABRICKS_MODEL_SONNET=system.ai.claude-sonnet-5-5
DATABRICKS_MODEL_OPUS=system.ai.claude-opus-5-5

# 第 8 課記憶：LibSQL 存成本機檔案
MASTRA_DB_URL=file:./data/mastra.db

# 第 9 課 Studio／HTTP API 的 port（不填預設 4111）
# PORT=4111
